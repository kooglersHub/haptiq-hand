{
  "name": "haptiq-hand",
  "version": "0.1.0",
  "private": true,
  "description": "Development tools for the HaptIQ hand viewer",
  "scripts": {
    "test": "node scripts/test-node.cjs",
    "format": "prettier --write \"src/haptiq/digital_twin/**/*.js\" \"src/haptiq/digital_twin/**/*.cjs\" \"tests/**/*.js\" \"scripts/**/*.cjs\" \"src/haptiq/digital_twin/**/*.css\" \"src/haptiq/digital_twin/**/*.html\"",
    "format:check": "prettier --check \"src/haptiq/digital_twin/**/*.js\" \"src/haptiq/digital_twin/**/*.cjs\" \"tests/**/*.js\" \"scripts/**/*.cjs\" \"src/haptiq/digital_twin/**/*.css\" \"src/haptiq/digital_twin/**/*.html\"",
    "test:browser": "python scripts/test-browser.py"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "prettier": "3.9.10"
  }
}
